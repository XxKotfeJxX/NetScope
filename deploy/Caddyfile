{$NETSCOPE_DOMAIN} {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:8080
	}

	@operational path /readyz /metrics
	respond @operational 404

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@documents not path /assets/*
	header @documents Cache-Control "no-cache"

	header {
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	root * /srv
	try_files {path} /index.html
	file_server
}
