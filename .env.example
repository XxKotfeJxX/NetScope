APP_ENV=development
APP_VERSION=dev

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://netscope:netscope@localhost:5432/netscope?sslmode=disable
POSTGRES_PORT=5432

RUN_WORKERS=4
RUN_QUEUE_SIZE=100
PROBE_CONCURRENCY=8

DEFAULT_PROBE_TIMEOUT=5s
MAX_PROBE_TIMEOUT=30s
MAX_TCP_PORTS=10
MAX_REDIRECTS=5

NETWORK_POLICY=local
ALLOW_LOOPBACK_TARGETS=true
ALLOW_PRIVATE_TARGETS=true
ALLOW_LINK_LOCAL_TARGETS=false
ICMP_ENABLED=true
MONITORING_POLL_INTERVAL=10s
NOTIFICATION_TIMEOUT=10s

# Optional email alerts. Webhook alerts work without SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

SESSION_TTL=720h
SESSION_COOKIE_SECURE=false

LOG_LEVEL=debug
LOG_FORMAT=json

METRICS_ENABLED=false
METRICS_PORT=9090
