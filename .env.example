APP_ENV=development
APP_VERSION=dev

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://netscope:netscope@localhost:5432/netscope?sslmode=disable
POSTGRES_PORT=5432

RUN_WORKERS=4
RUN_QUEUE_SIZE=100
PROBE_CONCURRENCY=8

DEFAULT_PROBE_TIMEOUT=5s
MAX_PROBE_TIMEOUT=30s
MAX_TCP_PORTS=10
MAX_REDIRECTS=5

NETWORK_POLICY=local
ALLOW_LOOPBACK_TARGETS=true
ALLOW_PRIVATE_TARGETS=true
ALLOW_LINK_LOCAL_TARGETS=false

LOG_LEVEL=debug
LOG_FORMAT=json

METRICS_ENABLED=false
METRICS_PORT=9090
