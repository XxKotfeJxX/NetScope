# Copy to .env.production and pass it with:
# docker compose --env-file .env.production -f compose.production.yml up -d

NETSCOPE_DOMAIN=netscope.example.com
APP_VERSION=1.0.0

# Use a long, URL-safe password so DATABASE_URL needs no additional encoding.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DATABASE_URL=postgres://netscope:replace-with-a-random-url-safe-password@postgres:5432/netscope?sslmode=disable

ICMP_ENABLED=true
MONITORING_POLL_INTERVAL=10s
NOTIFICATION_TIMEOUT=10s

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

SESSION_TTL=720h
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_GENERAL=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_MUTATION=60
RATE_LIMIT_PUBLIC=60

# Keep false unless /metrics is restricted by an additional network control.
METRICS_ENABLED=false
LOG_LEVEL=info
